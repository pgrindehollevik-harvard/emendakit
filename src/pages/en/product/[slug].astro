---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import SchemaProduct from "~/components/SchemaProduct.astro";
import SchemaFAQPage from "~/components/SchemaFAQPage.astro";
import CTAStrip from "~/components/CTAStrip.astro";
import MediaCarousel from "~/components/MediaCarousel.astro";

import productHospitalStudio from "~/assets/photos/product-hospital-studio.webp";
import productHospitalBackside from "~/assets/photos/product-hospital-backside.jpg";
import productDentistContents from "~/assets/photos/product-dentist-contents.jpg";
import productDentistBackside from "~/assets/photos/product-dentist-backside.jpg";
import productHolder from "~/assets/photos/product-holder.jpg";

export async function getStaticPaths() {
  const products = await getCollection("products", ({ data }) => data.locale === "en");
  return products.map((product) => ({
    params: { slug: product.data.urlSlug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();
const url = `/en/product/${product.data.urlSlug}`;
const altUrl = `/produkt/${product.data.altSlug}`;

const gallery = product.data.productNumber === 1
  ? [
      { src: productHospitalStudio, alt: `${product.data.title} — contents of the kit`, caption: "Contents · open kit" },
      { src: productHospitalBackside, alt: `Back of ${product.data.title} with the Norwegian national anaphylaxis flowchart`, caption: "Anaphylaxis flowchart (back)" },
      { src: productHolder, alt: "Wall holder included with the kit", caption: "Wall holder included" },
    ]
  : [
      { src: productDentistContents, alt: `${product.data.title} — contents of the kit`, caption: "Contents · open kit" },
      { src: productDentistBackside, alt: `Back of ${product.data.title} with the flowchart adapted to dental services`, caption: "Anaphylaxis flowchart (back)" },
      { src: productHolder, alt: "Wall holder included with the kit", caption: "Wall holder included" },
    ];
---

<BaseLayout
  locale="en"
  altUrl={altUrl}
  title={`${product.data.title} — ${product.data.descriptor}`}
  description={product.data.summary}
>
  <SchemaProduct
    name={product.data.title}
    description={product.data.summary}
    url={url}
    productNumber={product.data.productNumber}
    audience={product.data.audience}
    deliveryTime={product.data.deliveryTime}
  />
  <SchemaFAQPage items={product.data.faq} />

  <article style="padding: 80px 32px; max-width: 880px; margin: 0 auto;">
    <p style="font-family: var(--font-mono); font-size: 12px; color: var(--color-navy); text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 14px;">
      №{product.data.productNumber.toString().padStart(2, "0")} · Anaphylaxis kit · {product.data.audience}
    </p>
    <h1 style="font-family: var(--font-display); font-size: clamp(36px, 4.4vw, 56px); font-weight: 500; letter-spacing: -0.03em; line-height: 1; margin: 0 0 18px;">
      {product.data.title}
    </h1>
    <p style="font-size: 19px; line-height: 1.55; color: var(--color-ink-2); margin: 0 0 32px;">
      {product.data.summary}
    </p>

    <div style="margin: 0 0 48px;">
      <MediaCarousel slides={gallery} prevLabel="Previous image" nextLabel="Next image" />
    </div>

    <Content />

    <section class="details">
      <h2>Product details</h2>

      <h3 class="group">Specifications</h3>
      <dl class="spec-grid">
        <dt>Dimensions (L×W×H, external)</dt><dd>251 × 142 × 67 mm</dd>
        <dt>Dimensions (L×W×H, internal)</dt><dd>209 × 108 × 57 mm</dd>
        <dt>Weight</dt><dd>1.4 kg (ready to use)</dd>
        <dt>Material</dt><dd>Durable, waterproof and shock-resistant polymer</dd>
        <dt>Ingress protection</dt><dd>IP67 — withstands dust and submersion in water up to 1 metre for up to 30 minutes</dd>
        <dt>Delivery time</dt><dd>{product.data.deliveryTime}</dd>
      </dl>

      <h3 class="group">Design and function</h3>
      <ul class="bulleted">
        <li>Transparent lid for rapid visual overview of contents</li>
        <li>Robust construction with internal rubber lining for extra protection</li>
        <li>Latch that's easy to open in an acute situation</li>
        <li>Automatic pressure-equalisation valve for easy opening during transport (e.g. air travel)</li>
        <li>Smooth surface that's easy to clean</li>
      </ul>

      <h3 class="group">Internal system</h3>
      <ul class="bulleted">
        <li>Fitted insert with a fixed place for every component</li>
        <li>High colour contrast and engraving for rapid identification</li>
        <li>Light-protected storage of adrenaline</li>
        <li>Non-absorbent material prevents liquid penetration</li>
        <li>Durable top plate for permanent labelling</li>
      </ul>

      <h3 class="group">Practical information</h3>
      <ul class="bulleted">
        <li>Flowchart per national guidelines, clearly visible on the back of the kit</li>
        <li>Field for marking next check / expiry date</li>
        <li>Wall holder included</li>
        <li>Delivered without medications</li>
        <li>Lifetime warranty under normal use</li>
      </ul>
    </section>

    <h2 class="qa-heading">Questions and answers</h2>
    <div style="display: grid; gap: 16px;">
      {product.data.faq.map((q) => (
        <details style="padding: 16px 0; border-top: 1px solid var(--color-rule);">
          <summary style="font-family: var(--font-display); font-size: 17px; font-weight: 500; cursor: pointer;">{q.question}</summary>
          <p style="font-size: 14px; line-height: 1.6; color: var(--color-ink-2); margin: 12px 0 0;">{q.answer}</p>
        </details>
      ))}
    </div>
  </article>

  <CTAStrip
    title={`Request a quote for ${product.data.title}`}
    body={`${product.data.priceLabel} · Delivery time ${product.data.deliveryTime.toLowerCase()}. Send a short description of the department, number of kits and preferred delivery location.`}
    primary={{
      href: `/en/contact?topic=${encodeURIComponent(product.data.title)}`,
      label: "Request a quote →",
    }}
    secondary={{
      href: "/en/training",
      label: "See training videos",
    }}
  />
</BaseLayout>

<style>
  .details {
    margin: 48px 0 24px;
    padding: 32px;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-xl);
  }
  .details h2 {
    margin: 0 0 24px;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .details .group {
    margin: 32px 0 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy);
  }
  .details .group:first-of-type { margin-top: 0; }
  .details .spec-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 12px 24px;
    margin: 0;
    font-size: 14px;
  }
  .details .spec-grid dt {
    font-family: var(--font-mono);
    color: var(--color-ink-3);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .details .spec-grid dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: 500;
  }
  .details .bulleted {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .details .bulleted li {
    padding: 10px 0 10px 18px;
    border-top: 1px solid var(--color-rule);
    color: var(--color-ink);
    font-size: 15px;
    line-height: 1.5;
    position: relative;
  }
  .details .bulleted li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 19px;
    width: 6px;
    height: 6px;
    background: var(--color-cyan);
    border-radius: 50%;
  }
  .qa-heading {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
    margin: 48px 0 16px;
  }
  @media (max-width: 560px) {
    .details { padding: 24px; }
    .details .spec-grid { grid-template-columns: 1fr; gap: 4px 0; }
    .details .spec-grid dt { margin-top: 8px; }
  }
</style>
