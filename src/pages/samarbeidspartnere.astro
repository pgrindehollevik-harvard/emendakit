---
import { getCollection } from "astro:content";
import ReferenceListPage, { type ReferenceEntry } from "~/components/ReferenceListPage.astro";

const partners = (await getCollection("partners", ({ data }) => data.locale === "no"))
  .sort((a, b) => a.data.order - b.data.order);

const entries: ReferenceEntry[] = await Promise.all(
  partners.map(async (p) => ({
    id: p.slug.replace(/\.no$/, ""),
    kicker: p.data.role,
    title: p.data.name,
    url: p.data.url,
    urlLabel: p.data.url ? new URL(p.data.url).hostname : undefined,
    Content: (await p.render()).Content,
  })),
);
---

<ReferenceListPage
  locale="no"
  altUrl="/en/partners"
  title="Samarbeidspartnere · EmendaKit"
  description="Faglige og industrielle samarbeidspartnere bak EmendaKit anafylaksiskrin: klinisk rådgivning fra tannhelsetjenesten, produksjon hos Fosen Tools og medlemskap i Vilje Helseklynge."
  eyebrow="Samarbeidspartnere"
  heading="Faglige og industrielle samarbeidspartnere."
  lede="Klinikere, en norsk industriprodusent og et helseklyngemiljø har bidratt til at anafylaksiskrinet er praktisk, robust og klart for bruk."
  entries={entries}
  cta={{
    title: "Vil du samarbeide med EmendaKit?",
    body: "Vi er åpne for faglige innspill, pilotprosjekter og nye bruksområder.",
    primary: { href: "/kontakt", label: "Ta kontakt →" },
    secondary: { href: "/om-oss", label: "Om oss" },
  }}
/>
