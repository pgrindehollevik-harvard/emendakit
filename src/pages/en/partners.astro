---
import { getCollection } from "astro:content";
import ReferenceListPage, { type ReferenceEntry } from "~/components/ReferenceListPage.astro";

const partners = (await getCollection("partners", ({ data }) => data.locale === "en"))
  .sort((a, b) => a.data.order - b.data.order);

const entries: ReferenceEntry[] = await Promise.all(
  partners.map(async (p) => ({
    id: p.slug.replace(/\.en$/, ""),
    kicker: p.data.role,
    title: p.data.name,
    url: p.data.url,
    urlLabel: p.data.url ? new URL(p.data.url).hostname : undefined,
    Content: (await p.render()).Content,
  })),
);
---

<ReferenceListPage
  locale="en"
  altUrl="/samarbeidspartnere"
  title="Partners · EmendaKit"
  description="Clinical and industrial partners behind the EmendaKit anaphylaxis kit: clinical advice from dental practice, manufacturing by Fosen Tools and membership of the Vilje health cluster."
  eyebrow="Partners"
  heading="Clinical and industrial partners."
  lede="EmendaKit was developed by healthcare professionals, but not alone. Clinicians, a Norwegian industrial manufacturer and a health innovation cluster have helped make the anaphylaxis kit practical, robust and ready for use."
  entries={entries}
  cta={{
    title: "Want to work with EmendaKit?",
    body: "We welcome clinical input, pilot projects and new settings for anaphylaxis kits and custom solutions.",
    primary: { href: "/en/contact", label: "Get in touch →" },
    secondary: { href: "/en/about", label: "About us" },
  }}
/>
