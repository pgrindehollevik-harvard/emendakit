---
import BaseLayout from "~/layouts/BaseLayout.astro";
import CTAStrip from "~/components/CTAStrip.astro";

const process = [
  { number: "01", title: "Designsamtale", text: "Kartlegging av behov, scenarioer og krav." },
  { number: "02", title: "Pilot", text: "Testing og justering i praksis." },
  { number: "03", title: "Levering", text: "Ferdig tilpasset løsning tas i bruk." },
];

const features = [
  "Fast plass for hvert legemiddel og hver komponent",
  "Tydelig merking som støtter handling under tidspress",
  "Mulighet for pilot før endelig løsning tas i bruk",
];
---

<BaseLayout
  locale="no"
  altUrl="/en/services"
  title="Tjenester · Medisinske akuttskrin og beredskapsløsninger · EmendaKit"
  description="EmendaKit utvikler og tilpasser medisinske akuttskrin for helsetjenesten, tannklinikker, treningssentre, barnehager, luftfart og sjøfart, i offentlig og privat sektor."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Tjenester · Medisinske akuttskrin og beredskapsløsninger</p>
        <h1>Når eksisterende løsninger ikke dekker behovet.</h1>
      </div>
      <p class="lede">
        Vi utvikler og tilpasser medisinske akuttskrin i samarbeid med dere,
        basert på deres prosedyrer, omgivelser og situasjoner som kan oppstå.
        Løsningene utformes med fokus på struktur, oversikt og rask
        tilgjengelighet, slik at de støtter riktig og effektiv håndtering når
        det haster.
      </p>
    </div>
  </section>

  <section class="for-whom" aria-labelledby="for-whom-heading">
    <div class="container audience-grid">
      <div>
        <p class="eyebrow">For hvem</p>
        <h2 id="for-whom-heading">Beredskap som speiler bruken.</h2>
      </div>
      <div class="audience-copy">
        <p>
          Behovstilpassede løsninger er utviklet for miljøer der beredskapen
          må speile konkrete brukssituasjoner, arbeidsflyt og krav. Dette
          gjelder både kliniske miljøer og andre arenaer med behov for
          akuttberedskap, fra sykehus og ambulansetjenester til
          tannklinikker, barnehager, treningssentre samt innen luftfart og
          sjøfart, i både offentlig og privat sektor.
        </p>
        <ul>
          {features.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="one-system" aria-labelledby="one-system-heading">
    <div class="container one-system-grid">
      <div>
        <p class="eyebrow">Ett system · flere anvendelser</p>
        <h2 id="one-system-heading">Samme rammeverk, tilpasset miljøet.</h2>
      </div>
      <p>
        EmendaKit bygger på en systematisk oppbygning som kan tilpasses ulike
        miljøer uten å gå på kompromiss med oversikt og brukervennlighet.
      </p>
    </div>
  </section>

  <section class="process" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Hvordan vi jobber</p>
        <h2 id="process-heading">Fra behov til levering, i tre steg.</h2>
      </div>
      <ol class="process-list">
        {process.map((step) => (
          <li>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CTAStrip
    title="Praktisk startpunkt: uforpliktende designsamtale."
    body="Ta med scenarioene og behovene dere står i, så skisserer vi en løsning før dere tar stilling til videre pilot."
    primary={{ href: "/kontakt?emne=Behovstilpasset%20skrin", label: "Be om designsamtale →" }}
    secondary={{ href: "/produkter", label: "Se anafylaksiskrinene" }}
  />
</BaseLayout>

<style>
  .container { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
  .eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--color-navy);
    text-transform: uppercase;
  }
  h1, h2, h3 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  .hero { padding: 88px 0 72px; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.8fr);
    gap: 56px;
    align-items: end;
  }
  .hero h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(42px, 5.4vw, 66px);
    line-height: 1.0;
  }
  .lede {
    margin: 0;
    color: var(--color-ink-2);
    font-size: 18px;
    line-height: 1.6;
  }
  .for-whom, .one-system, .process {
    padding: 78px 0;
    border-top: 1px solid var(--color-rule);
  }
  .for-whom { background: var(--color-cyan-soft); }
  .audience-grid, .one-system-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 1.1fr);
    gap: 56px;
    align-items: start;
  }
  .for-whom h2, .one-system h2, .process h2 {
    margin: 0;
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.05;
  }
  .audience-copy p, .one-system p {
    margin: 0 0 18px;
    color: var(--color-ink-2);
    font-size: 17px;
    line-height: 1.65;
  }
  .audience-copy ul {
    display: grid;
    gap: 12px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
  .audience-copy li {
    border-top: 1px solid var(--color-rule);
    padding-top: 12px;
    color: var(--color-ink);
    font-size: 15px;
  }
  .section-head { max-width: 720px; margin-bottom: 32px; }
  .process-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .process-list li {
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    padding: 28px;
  }
  .process-list span {
    display: block;
    margin-bottom: 32px;
    font-family: var(--font-mono);
    color: var(--color-navy);
    font-size: 12px;
    letter-spacing: 0.12em;
  }
  .process-list h3 {
    margin: 0 0 10px;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .process-list p {
    margin: 0;
    color: var(--color-ink-2);
    font-size: 15px;
    line-height: 1.6;
  }
  @media (max-width: 860px) {
    .hero-grid, .audience-grid, .one-system-grid { grid-template-columns: 1fr; }
    .process-list { grid-template-columns: 1fr; }
    .hero { padding-top: 64px; }
  }
</style>
