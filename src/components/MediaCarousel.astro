---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Slide {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  slides: Slide[];
  prevLabel?: string;
  nextLabel?: string;
  widths?: number[];
  sizes?: string;
  /** image-area aspect ratio, e.g. "3 / 2" or "16 / 11" */
  aspect?: string;
}

const {
  slides,
  prevLabel = "Forrige bilde",
  nextLabel = "Neste bilde",
  widths = [480, 720, 1080, 1440],
  sizes = "(min-width: 768px) 880px, 100vw",
  aspect = "3 / 2",
} = Astro.props;

const hasCaptions = slides.some((s) => s.caption);
---

<div class="media-carousel" data-active="0" style={`--carousel-aspect: ${aspect};`}>
  <div class="frame">
    {slides.map((s, i) => (
      <Image
        src={s.src}
        alt={s.alt}
        class:list={["slide", { "is-on": i === 0 }]}
        widths={widths}
        sizes={sizes}
      />
    ))}
    {slides.length > 1 && (
      <>
        <button type="button" class="nav prev" aria-label={prevLabel}>‹</button>
        <button type="button" class="nav next" aria-label={nextLabel}>›</button>
      </>
    )}
  </div>
  {hasCaptions && (
    <div class="captions" aria-live="polite">
      {slides.map((s, i) => (
        <span class:list={["cap", { "is-on": i === 0 }]}>{s.caption}</span>
      ))}
    </div>
  )}
</div>

<style>
  .media-carousel {
    background: var(--color-bg);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .frame {
    position: relative;
    aspect-ratio: var(--carousel-aspect, 3 / 2);
  }
  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 24px;
    box-sizing: border-box;
    opacity: 0;
    transition: opacity 220ms var(--ease-soft);
    pointer-events: none;
  }
  .slide.is-on {
    opacity: 1;
    pointer-events: auto;
  }
  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: rgb(18 37 68 / 0.55);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background 160ms var(--ease-soft);
    z-index: 2;
  }
  .nav:hover,
  .nav:focus-visible {
    background: var(--color-navy-deep);
  }
  .nav.prev { left: 16px; }
  .nav.next { right: 16px; }
  .captions {
    padding: 14px 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-surface);
    border-top: 1px solid var(--color-rule);
  }
  .cap { display: none; }
  .cap.is-on { display: inline; }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".media-carousel").forEach((mc) => {
    const slides = mc.querySelectorAll<HTMLElement>(".slide");
    const caps = mc.querySelectorAll<HTMLElement>(".cap");
    const total = slides.length;
    if (total < 2) return;
    const set = (i: number) => {
      mc.dataset.active = String(i);
      slides.forEach((s, si) => s.classList.toggle("is-on", si === i));
      caps.forEach((c, ci) => c.classList.toggle("is-on", ci === i));
    };
    const go = (delta: number) => {
      const cur = Number(mc.dataset.active ?? "0");
      set((cur + delta + total) % total);
    };
    mc.querySelector<HTMLButtonElement>(".nav.prev")?.addEventListener("click", (e) => {
      e.preventDefault();
      go(-1);
    });
    mc.querySelector<HTMLButtonElement>(".nav.next")?.addEventListener("click", (e) => {
      e.preventDefault();
      go(1);
    });
  });
</script>
