---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContactForm from "~/components/ContactForm.astro";
import { SITE } from "~/lib/site";

const telHref = `tel:${SITE.phone.replace(/\s/g, "")}`;
---

<BaseLayout
  locale="no"
  altUrl="/en/contact"
  title="Kontakt · EmendaKit"
  description="Bestill anafylaksiskrin med pris og levering, eller still et spørsmål. EmendaKit svarer innen én virkedag."
>
  <section class="hero">
    <div class="container">
      <h1>Hva trenger dere?</h1>
      <p class="lede">Velg, fyll inn, og Kjersti svarer innen én virkedag.</p>
    </div>
  </section>

  <section class="contact">
    <div class="container">
      <ContactForm locale="no" />
      <p class="direct">
        Eller direkte: <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={telHref}>{SITE.phone}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .container { max-width: 880px; margin: 0 auto; padding: 0 32px; }
  .hero { padding: 80px 0 40px; text-align: center; }
  .hero h1 {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.03em;
    font-size: clamp(38px, 5.2vw, 60px);
    line-height: 1.0;
  }
  .lede {
    margin: 0;
    color: var(--color-ink-2);
    font-size: 18px;
    line-height: 1.6;
  }
  .contact { padding: 8px 0 96px; }
  .direct {
    margin: 28px 0 0;
    text-align: center;
    font-size: 15px;
    color: var(--color-ink-3);
  }
  .direct a {
    color: var(--color-navy);
    border-bottom: 1px solid color-mix(in srgb, var(--color-navy) 35%, transparent);
    padding-bottom: 1px;
  }
  @media (max-width: 640px) {
    .container { padding: 0 20px; }
    .hero { padding-top: 56px; }
  }
</style>
