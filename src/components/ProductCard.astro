---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  summary: string;
  href: string;
  productNumber: number;
  image?: ImageMetadata;
  imageAlt?: string;
  imageLabel?: string;
  image2?: ImageMetadata;
  image2Alt?: string;
  image2Label?: string;
  prevLabel?: string;
  nextLabel?: string;
  priceLabel?: string;
  linkLabel?: string;
  orderHref?: string;
  orderLabel?: string;
  variant?: "clinic" | "dental";
}

const {
  title,
  summary,
  href,
  productNumber,
  image,
  imageAlt = title,
  imageLabel,
  image2,
  image2Alt,
  image2Label,
  prevLabel = "Forrige bilde",
  nextLabel = "Neste bilde",
  priceLabel = "3 590 kr eks. mva",
  linkLabel = "Produktdetaljer",
  orderHref,
  orderLabel = "Bestill nå",
  variant = productNumber === 1 ? "clinic" : "dental",
} = Astro.props;

const hasToggle = Boolean(image && image2);

// Cards show the short name for now; the full product name stays on the detail page.
const heading = title.replace(/ (Anafylaksi|Anaphylaxis)\b/, "");
---

<article class="product-card">
  <div class:list={["product-img", `kit-${variant}`, { "has-photo": image }]}>
    {hasToggle && image && image2 ? (
      <div class="image-toggle" data-active="0">
        <Image src={image} alt={imageAlt} class="img-slide is-on" widths={[480, 720, 1080]} sizes="(min-width: 1024px) 40vw, 100vw" />
        <Image src={image2} alt={image2Alt ?? title} class="img-slide" widths={[480, 720, 1080]} sizes="(min-width: 1024px) 40vw, 100vw" />
        <button type="button" class="img-nav prev" aria-label={prevLabel}>‹</button>
        <button type="button" class="img-nav next" aria-label={nextLabel}>›</button>
        {(imageLabel || image2Label) && (
          <div class="img-caption" aria-live="polite">
            <span class="cap cap-0">{imageLabel}</span>
            <span class="cap cap-1">{image2Label}</span>
          </div>
        )}
      </div>
    ) : image ? (
      <Image src={image} alt={imageAlt} widths={[480, 720, 1080]} sizes="(min-width: 1024px) 40vw, 100vw" />
    ) : (
      <div class="kit-visual" aria-hidden="true">
        <span class="kit-lid"></span>
        <span class="kit-cell cell-one"></span>
        <span class="kit-cell cell-two"></span>
        <span class="kit-base"></span>
        <span class="kit-signal"></span>
      </div>
    )}
  </div>

  <div class="product-body">
    <h3>{heading}</h3>
    <p>{summary}</p>
    <div class="product-foot">
      <div class="product-actions">
        {orderHref && <a href={orderHref} class="order-btn">{orderLabel}</a>}
        <a href={href} class="detail-link">{linkLabel}</a>
      </div>
      <span class="price">{priceLabel}</span>
    </div>
  </div>
</article>

<style>
  .product-card {
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .product-img {
    position: relative;
    aspect-ratio: 16 / 11;
    background:
      radial-gradient(ellipse 60% 50% at 50% 50%, color-mix(in srgb, var(--color-cyan) 12%, transparent) 0%, transparent 70%),
      linear-gradient(180deg, var(--color-navy-deep) 0%, var(--color-ink) 100%);
    overflow: hidden;
  }
  .product-img.kit-dental {
    background:
      radial-gradient(ellipse 60% 50% at 50% 50%, color-mix(in srgb, var(--color-cream) 14%, transparent) 0%, transparent 70%),
      linear-gradient(180deg, color-mix(in srgb, var(--color-navy) 65%, var(--color-ink)) 0%, var(--color-ink) 100%);
  }
  .product-img.has-photo {
    background: var(--color-surface);
  }
  .product-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 16px;
  }
  .image-toggle {
    position: absolute;
    inset: 0;
  }
  .image-toggle .img-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 16px;
    box-sizing: border-box;
    opacity: 0;
    transition: opacity 220ms var(--ease-soft);
    pointer-events: none;
  }
  .image-toggle .img-slide.is-on {
    opacity: 1;
    pointer-events: auto;
  }
  .image-toggle .img-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: rgb(18 37 68 / 0.55);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background 160ms var(--ease-soft);
    z-index: 2;
  }
  .image-toggle .img-nav:hover,
  .image-toggle .img-nav:focus-visible {
    background: var(--color-navy-deep);
  }
  .image-toggle .img-nav.prev { left: 12px; }
  .image-toggle .img-nav.next { right: 12px; }
  .image-toggle .img-caption {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    background: rgb(18 37 68 / 0.78);
    color: #fff;
    font-size: 12px;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    pointer-events: none;
    z-index: 2;
  }
  .image-toggle .img-caption .cap { display: none; }
  .image-toggle[data-active="0"] .img-caption .cap-0,
  .image-toggle[data-active="1"] .img-caption .cap-1 { display: inline; }
  .kit-visual {
    position: absolute;
    inset: 16% 11%;
    border-radius: 14px;
    background: var(--color-navy);
    border: 2px solid var(--color-cyan);
    box-shadow: 0 24px 80px rgb(0 0 0 / 0.24);
  }
  .kit-dental .kit-visual {
    inset: 18% 16%;
  }
  .kit-visual span {
    position: absolute;
    border-radius: 6px;
    background: var(--color-navy-deep);
  }
  .kit-lid {
    top: 12%;
    left: 7%;
    right: 7%;
    height: 20%;
  }
  .kit-cell {
    top: 38%;
    height: 26%;
    width: 38%;
  }
  .cell-one {
    left: 7%;
  }
  .cell-two {
    right: 7%;
  }
  .kit-base {
    left: 7%;
    right: 7%;
    bottom: 6%;
    height: 22%;
  }
  .kit-signal {
    top: 6%;
    right: 5%;
    width: 18px;
    height: 18px;
    border-radius: var(--radius-pill);
    background: var(--color-signal);
  }
  .product-body {
    padding: 32px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  h3 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin: 0 0 14px;
  }
  p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink-2);
    margin: 0 0 20px;
  }
  .product-foot {
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--color-rule);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .product-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .order-btn,
  .detail-link {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    transition: background 160ms var(--ease-soft), border-color 160ms var(--ease-soft), color 160ms var(--ease-soft);
  }
  .order-btn {
    background: var(--color-navy);
    color: var(--color-bg);
  }
  .order-btn:hover,
  .order-btn:focus-visible {
    background: var(--color-navy-deep);
  }
  .detail-link {
    color: var(--color-navy);
    border-color: var(--color-rule);
  }
  .detail-link:hover,
  .detail-link:focus-visible {
    background: var(--color-cyan-soft);
    border-color: var(--color-cyan-soft);
  }
  .price {
    font-size: 13px;
    color: var(--color-ink-3);
  }
  @media (max-width: 520px) {
    .product-body {
      padding: 24px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".image-toggle").forEach((toggle) => {
    const slides = toggle.querySelectorAll<HTMLImageElement>(".img-slide");
    const total = slides.length;
    if (total < 2) return;
    const set = (i: number) => {
      toggle.dataset.active = String(i);
      slides.forEach((s, si) => s.classList.toggle("is-on", si === i));
    };
    const go = (delta: number) => {
      const cur = Number(toggle.dataset.active ?? "0");
      set((cur + delta + total) % total);
    };
    toggle.querySelector<HTMLButtonElement>(".img-nav.prev")?.addEventListener("click", (e) => {
      e.preventDefault();
      go(-1);
    });
    toggle.querySelector<HTMLButtonElement>(".img-nav.next")?.addEventListener("click", (e) => {
      e.preventDefault();
      go(1);
    });
  });
</script>
