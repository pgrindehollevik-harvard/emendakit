---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import SchemaProduct from "~/components/SchemaProduct.astro";
import SchemaFAQPage from "~/components/SchemaFAQPage.astro";
import CTAStrip from "~/components/CTAStrip.astro";
import MediaCarousel from "~/components/MediaCarousel.astro";

import productHospitalStudio from "~/assets/photos/product-hospital-studio.webp";
import productHospitalBackside from "~/assets/photos/product-hospital-backside.jpg";
import productDentistStudio from "~/assets/photos/product-dentist-studio.jpg";
import productDentistBackside from "~/assets/photos/product-dentist-backside.jpg";
import productHolder from "~/assets/photos/product-holder.jpg";

export async function getStaticPaths() {
  const products = await getCollection("products", ({ data }) => data.locale === "en");
  return products.map((product) => ({
    params: { slug: product.data.urlSlug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();
const url = `/en/product/${product.data.urlSlug}`;
const altUrl = `/produkt/${product.data.altSlug}`;
const orderHref = `/en/contact?topic=${encodeURIComponent(product.data.title)}`;

const gallery = product.data.productNumber === 1
  ? [
      { src: productHospitalStudio, alt: `${product.data.title}, contents of the kit`, caption: "Contents, open kit" },
      { src: productHospitalBackside, alt: `Back of ${product.data.title} with the Norwegian national anaphylaxis flowchart`, caption: "Flowchart on the back" },
      { src: productHolder, alt: "Wall holder included with the kit", caption: "Wall holder included" },
    ]
  : [
      { src: productDentistStudio, alt: `${product.data.title}, contents of the kit`, caption: "Contents, open kit" },
      { src: productDentistBackside, alt: `Back of ${product.data.title} with the flowchart adapted to dental services`, caption: "Flowchart on the back" },
      { src: productHolder, alt: "Wall holder included with the kit", caption: "Wall holder included" },
    ];
---

<BaseLayout
  locale="en"
  altUrl={altUrl}
  title={`${product.data.title} · ${product.data.descriptor}`}
  description={product.data.summary}
>
  <SchemaProduct
    name={product.data.title}
    description={product.data.summary}
    url={url}
    productNumber={product.data.productNumber}
    audience={product.data.audience}
    deliveryTime={product.data.deliveryTime}
  />
  <SchemaFAQPage items={product.data.faq} />

  <article class="product">
    <header class="intro">
      <h1>{product.data.title}</h1>
      <p class="lede">{product.data.summary}</p>
      <p class="buy">
        <a href={orderHref} class="order">Order</a>
        <span>{product.data.priceLabel} · Delivery {product.data.deliveryTime.toLowerCase()}</span>
      </p>
    </header>

    <MediaCarousel slides={gallery} prevLabel="Previous image" nextLabel="Next image" />

    <div class="prose">
      <Content />
    </div>

    <section class="specs">
      <h2>Specifications</h2>
      <dl>
        {product.data.specs.map((s) => (
          <>
            <dt>{s.key}</dt>
            <dd>{s.value}</dd>
          </>
        ))}
      </dl>
    </section>

    <section class="faq">
      <h2>Questions and answers</h2>
      {product.data.faq.map((q) => (
        <details>
          <summary>{q.question}</summary>
          <p>{q.answer}</p>
        </details>
      ))}
    </section>
  </article>

  <CTAStrip
    title={`Order ${product.data.title}`}
    body={`${product.data.priceLabel} per kit, NOK 3,390 from 5 kits. Delivery ${product.data.deliveryTime.toLowerCase()}.`}
    primary={{ href: orderHref, label: "Order →" }}
    secondary={{ href: "/en/training", label: "See training videos" }}
  />
</BaseLayout>

<style>
  .product {
    max-width: 880px;
    margin: 0 auto;
    padding: 72px 32px 80px;
  }
  .intro { margin-bottom: 40px; }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 4.4vw, 56px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0 0 18px;
  }
  .lede {
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-ink-2);
    margin: 0 0 24px;
    max-width: 60ch;
  }
  .buy {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin: 0;
    font-size: 14px;
    color: var(--color-ink-3);
  }
  .order {
    display: inline-flex;
    align-items: center;
    padding: 11px 22px;
    border-radius: var(--radius-pill);
    background: var(--color-navy);
    color: var(--color-bg);
    font-size: 14px;
    font-weight: 500;
    transition: background 160ms var(--ease-soft);
  }
  .order:hover { background: var(--color-navy-deep); }
  .prose { margin: 48px 0 0; max-width: 60ch; }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 32px 0 10px;
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-ink-2);
    margin: 0 0 12px;
  }
  .specs, .faq { margin-top: 56px; }
  h2 {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .specs dl {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 0 24px;
    margin: 0;
    font-size: 15px;
  }
  .specs dt, .specs dd {
    padding: 12px 0;
    border-top: 1px solid var(--color-rule);
    margin: 0;
  }
  .specs dt { color: var(--color-ink-3); }
  .specs dd { color: var(--color-ink); }
  .faq details { border-top: 1px solid var(--color-rule); padding: 14px 0; }
  .faq summary {
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: "+";
    color: var(--color-ink-3);
    font-weight: 400;
    flex: 0 0 auto;
  }
  .faq details[open] summary::after { content: "−"; }
  .faq p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink-2);
    margin: 10px 0 0;
    max-width: 60ch;
  }
  @media (max-width: 560px) {
    .product { padding: 48px 20px 64px; }
    .specs dl { grid-template-columns: 1fr; }
    .specs dt { padding-bottom: 2px; }
    .specs dd { border-top: none; padding-top: 0; }
  }
</style>
