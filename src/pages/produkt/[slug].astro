---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import SchemaProduct from "~/components/SchemaProduct.astro";
import SchemaFAQPage from "~/components/SchemaFAQPage.astro";
import CTAStrip from "~/components/CTAStrip.astro";
import MediaCarousel from "~/components/MediaCarousel.astro";

import productHospitalStudio from "~/assets/photos/product-hospital-studio.webp";
import productHospitalBackside from "~/assets/photos/product-hospital-backside.jpg";
import productDentistContents from "~/assets/photos/product-dentist-contents.jpg";
import productDentistBackside from "~/assets/photos/product-dentist-backside.jpg";
import productHolder from "~/assets/photos/product-holder.jpg";

export async function getStaticPaths() {
  const products = await getCollection("products", ({ data }) => data.locale === "no");
  return products.map((product) => ({
    params: { slug: product.data.urlSlug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();
const url = `/produkt/${product.data.urlSlug}`;
const altUrl = `/en/product/${product.data.altSlug}`;

const gallery = product.data.productNumber === 1
  ? [
      { src: productHospitalStudio, alt: `${product.data.title} — innholdet i skrinet`, caption: "Innhold · åpent skrin" },
      { src: productHospitalBackside, alt: `Baksiden av ${product.data.title} med nasjonalt anafylaksiflytskjema`, caption: "Anafylaksiflytskjema (bakside)" },
      { src: productHolder, alt: "Veggfestet som følger med skrinet", caption: "Veggfeste inkludert" },
    ]
  : [
      { src: productDentistContents, alt: `${product.data.title} — innholdet i skrinet`, caption: "Innhold · åpent skrin" },
      { src: productDentistBackside, alt: `Baksiden av ${product.data.title} med flytskjema tilpasset tannhelsetjenesten`, caption: "Anafylaksiflytskjema (bakside)" },
      { src: productHolder, alt: "Veggfestet som følger med skrinet", caption: "Veggfeste inkludert" },
    ];
---

<BaseLayout
  locale="no"
  altUrl={altUrl}
  title={`${product.data.title} — ${product.data.descriptor}`}
  description={product.data.summary}
>
  <SchemaProduct
    name={product.data.title}
    description={product.data.summary}
    url={url}
    productNumber={product.data.productNumber}
    audience={product.data.audience}
    deliveryTime={product.data.deliveryTime}
  />
  <SchemaFAQPage items={product.data.faq} />

  <article style="padding: 80px 32px; max-width: 880px; margin: 0 auto;">
    <p style="font-family: var(--font-mono); font-size: 12px; color: var(--color-navy); text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 14px;">
      №{product.data.productNumber.toString().padStart(2, "0")} · Anafylaksiskrin · {product.data.audience}
    </p>
    <h1 style="font-family: var(--font-display); font-size: clamp(36px, 4.4vw, 56px); font-weight: 500; letter-spacing: -0.03em; line-height: 1; margin: 0 0 18px;">
      {product.data.title}
    </h1>
    <p style="font-size: 19px; line-height: 1.55; color: var(--color-ink-2); margin: 0 0 32px;">
      {product.data.summary}
    </p>

    <div style="margin: 0 0 48px;">
      <MediaCarousel slides={gallery} prevLabel="Forrige bilde" nextLabel="Neste bilde" />
    </div>

    <Content />

    <section class="details">
      <h2>Produktdetaljer</h2>

      <h3 class="group">Spesifikasjoner</h3>
      <dl class="spec-grid">
        <dt>Mål (utvendig, L×B×H)</dt><dd>251 × 142 × 67 mm</dd>
        <dt>Mål (innvendig, L×B×H)</dt><dd>209 × 108 × 57 mm</dd>
        <dt>Vekt</dt><dd>1,4 kg (ferdig klargjort)</dd>
        <dt>Materiale</dt><dd>Slitesterk, vanntett og støtsikker polymer</dd>
        <dt>Tetthetsgrad</dt><dd>IP67 – tåler støv og nedsenkning i vann opptil 1 meter i inntil 30 minutter</dd>
        <dt>Leveringstid</dt><dd>{product.data.deliveryTime}</dd>
      </dl>

      <h3 class="group">Design og funksjon</h3>
      <ul class="bulleted">
        <li>Transparent lokk gir rask visuell oversikt over innhold</li>
        <li>Robust konstruksjon med innvendig gummiforing for ekstra beskyttelse</li>
        <li>Låseklakk som er enkel å åpne i en akutt situasjon</li>
        <li>Automatisk trykkutligningsventil for enkel åpning ved transport (f.eks. i fly)</li>
        <li>Glatt overflate som er enkel å rengjøre</li>
      </ul>

      <h3 class="group">Innvendig system</h3>
      <ul class="bulleted">
        <li>Formtilpasset innlegg med faste plasser for hver komponent</li>
        <li>Høy fargekontrast og inngravering gir rask identifisering</li>
        <li>Lyssikret oppbevaring av adrenalin</li>
        <li>Ikke-absorberende materiale som hindrer at væske trekker inn</li>
        <li>Slitesterk topplate med mulighet for permanent merking</li>
      </ul>

      <h3 class="group">Praktisk informasjon</h3>
      <ul class="bulleted">
        <li>Flytskjema etter nasjonale retningslinjer godt synlig på baksiden av skrinet</li>
        <li>Felt for merking av neste kontroll / utløpsdato</li>
        <li>Veggfeste medfølger</li>
        <li>Leveres uten medikamenter</li>
        <li>Livstidsgaranti ved normalt bruk</li>
      </ul>
    </section>

    <h2 class="qa-heading">Spørsmål og svar</h2>
    <div style="display: grid; gap: 16px;">
      {product.data.faq.map((q) => (
        <details style="padding: 16px 0; border-top: 1px solid var(--color-rule);">
          <summary style="font-family: var(--font-display); font-size: 17px; font-weight: 500; cursor: pointer;">{q.question}</summary>
          <p style="font-size: 14px; line-height: 1.6; color: var(--color-ink-2); margin: 12px 0 0;">{q.answer}</p>
        </details>
      ))}
    </div>
  </article>

  <CTAStrip
    title={`Be om tilbud på ${product.data.title}`}
    body={`${product.data.priceLabel} · Leveringstid ${product.data.deliveryTime.toLowerCase()}. Send en kort beskrivelse av avdeling, antall skrin og ønsket leveringssted.`}
    primary={{
      href: `/kontakt?emne=${encodeURIComponent(product.data.title)}`,
      label: "Be om tilbud →",
    }}
    secondary={{
      href: "/opplaering",
      label: "Se opplæringsfilmer",
    }}
  />
</BaseLayout>

<style>
  .details {
    margin: 48px 0 24px;
    padding: 32px;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-xl);
  }
  .details h2 {
    margin: 0 0 24px;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .details .group {
    margin: 32px 0 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy);
  }
  .details .group:first-of-type { margin-top: 0; }
  .details .spec-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 12px 24px;
    margin: 0;
    font-size: 14px;
  }
  .details .spec-grid dt {
    font-family: var(--font-mono);
    color: var(--color-ink-3);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .details .spec-grid dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: 500;
  }
  .details .bulleted {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .details .bulleted li {
    padding: 10px 0 10px 18px;
    border-top: 1px solid var(--color-rule);
    color: var(--color-ink);
    font-size: 15px;
    line-height: 1.5;
    position: relative;
  }
  .details .bulleted li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 19px;
    width: 6px;
    height: 6px;
    background: var(--color-cyan);
    border-radius: 50%;
  }
  .qa-heading {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
    margin: 48px 0 16px;
  }
  @media (max-width: 560px) {
    .details { padding: 24px; }
    .details .spec-grid { grid-template-columns: 1fr; gap: 4px 0; }
    .details .spec-grid dt { margin-top: 8px; }
  }
</style>
