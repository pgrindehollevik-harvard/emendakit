---
import { SITE, type Locale } from "~/lib/site";
import logo from "~/assets/logo/emendakit-logo.png";

interface Props {
  locale: Locale;
  altUrl: string;
}

const { locale, altUrl } = Astro.props;
const t = locale === "no";

const productLinks = t
  ? [
      { href: "/produkt/emendakit-hospital", label: "EmendaKit Helse" },
      { href: "/produkt/emendakit-dentist", label: "EmendaKit Tannklinikk" },
      { href: "/tjenester", label: "Behovstilpasset" },
    ]
  : [
      { href: "/en/product/emendakit-hospital", label: "EmendaKit Healthcare" },
      { href: "/en/product/emendakit-dentist", label: "EmendaKit Dental" },
      { href: "/en/services", label: "Custom kits" },
    ];

const companyLinks = t
  ? [
      { href: "/om-oss", label: "Om oss" },
      { href: "/opplaering", label: "Opplæringsfilmer" },
      { href: "/omtale", label: "Omtale" },
    ]
  : [
      { href: "/en/about", label: "About" },
      { href: "/en/training", label: "Training videos" },
      { href: "/en/press", label: "Press" },
    ];

const contactLinks = [
  { href: `mailto:${SITE.email}`, label: SITE.email },
  { href: `tel:${SITE.phone.replace(/\s/g, "")}`, label: SITE.phone },
];
---

<footer>
  <div class="container">
    <div class="foot">
      <div>
        <a href={t ? "/" : "/en/"} class="brand"><img src={logo.src} alt="EmendaKit" width="160" height="28" /></a>
      </div>
      <div>
        <h4>{t ? "Produkter" : "Products"}</h4>
        <ul>{productLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h4>{t ? "Selskap" : "Company"}</h4>
        <ul>{companyLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h4>{t ? "Kontakt" : "Contact"}</h4>
        <ul>{contactLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    </div>
    <div class="colophon">
      <span>© {new Date().getFullYear()} EmendaKit AS · {t ? "Designet og bygget i Norge" : "Designed and built in Norway"}</span>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 48px 0 32px;
    border-top: 1px solid var(--color-rule);
    background: var(--color-bg);
  }
  .container { max-width: 1320px; margin: 0 auto; padding: 0 32px; }
  .foot {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 32px;
  }
  .foot h4 {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink-3);
    margin: 0 0 14px;
  }
  .foot ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .foot a {
    color: var(--color-ink);
    font-size: 14px;
    text-decoration: none;
    transition: color 120ms var(--ease-soft);
  }
  .foot a:hover {
    color: var(--color-navy);
  }
  .foot .brand img {
    height: 28px;
    width: auto;
  }
  .colophon {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-rule);
    text-align: center;
    font-size: 12px;
    color: var(--color-ink-3);
  }
  @media (max-width: 840px) {
    .foot {
      grid-template-columns: 1fr 1fr;
    }
    .foot > div:first-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    footer {
      padding: 40px 0 28px;
    }
    .container {
      padding: 0 20px;
    }
    .foot {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
