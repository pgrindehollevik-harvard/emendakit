---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";

const services = await getCollection(
  "services",
  ({ data }) => data.locale === "no",
);
const service = services.find((entry) => entry.slug === "behovstilpasset");

if (!service) {
  throw new Error("Missing Norwegian service entry: behovstilpasset");
}

const process = [
  {
    number: "01",
    title: "Designsamtale",
    text: "Vi går gjennom scenarioer, prosedyrer og rom.",
  },
  {
    number: "02",
    title: "Forslag til pakking",
    text: "Vi skisserer innhold, layout og merking.",
  },
  {
    number: "03",
    title: "Pilot i klinikken",
    text: "Én eller noen få enheter testes av teamet som skal bruke skrinet.",
  },
  {
    number: "04",
    title: "Justering og levering",
    text: "Erfaringene fra pilot gir endelig pakking og levering.",
  },
];
---

<BaseLayout
  locale="no"
  altUrl={`/en/services/${service.data.altSlug}`}
  title={`${service.data.title} · EmendaKit`}
  description={service.data.summary}
>
  <article>
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <h1>{service.data.title}</h1>
        </div>
        <div class="hero-card">
          <p>{service.data.summary}</p>
          <a href="/kontakt?emne=Behovstilpasset%20skrin">
            Be om designsamtale →
          </a>
        </div>
      </div>
    </section>

    <section class="audience" aria-labelledby="audience-heading">
      <div class="container audience-grid">
        <div>
          <h2 id="audience-heading">Når standardpakken ikke er presis nok.</h2>
        </div>
        <div class="audience-copy">
          <p>
            Fødeavdelinger, vaksinestasjoner, akuttmottak, ambulanse og enheter
            med særskilte krav.
          </p>
          <ul>
            <li>Fast plass for hvert legemiddel og hver komponent.</li>
            <li>Merking som støtter deres prosedyre under tidspress.</li>
            <li>Mulighet for pilot før endelig levering.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="process" aria-labelledby="process-heading">
      <div class="container">
        <div class="section-head">
          <h2 id="process-heading">
            Fra klinisk behov til ferdig pakket skrin.
          </h2>
        </div>

        <ol class="process-list">
          {
            process.map((step) => (
              <li>
                <span>{step.number}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="cta">
      <div class="container cta-grid">
        <div>
          <h2>Send Kjersti en kort beskrivelse av behovet.</h2>
        </div>
        <div>
          <a href="/kontakt?emne=Behovstilpasset%20skrin" class="button">
            Be om designsamtale →
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .hero {
    padding: 84px 0 76px;
  }

  .hero-grid,
  .audience-grid,
  .cta-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.78fr);
    gap: 56px;
    align-items: start;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }

  h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(42px, 6vw, 72px);
    line-height: 0.98;
  }

  h2 {
    margin: 0;
    font-size: clamp(31px, 4vw, 48px);
    line-height: 1.04;
  }

  h3 {
    margin: 0 0 8px;
    font-size: 22px;
    letter-spacing: -0.015em;
  }

  .hero-card {
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    padding: 30px;
  }

  .hero-card p,
  .audience-copy p {
    margin: 0;
    color: var(--color-ink-2);
    font-size: 17px;
    line-height: 1.65;
  }

  .hero-card a,
  .button {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-top: 24px;
    border-radius: var(--radius-pill);
    background: var(--color-navy);
    color: var(--color-bg);
    padding: 14px 22px;
    font-weight: 500;
  }

  .audience {
    padding: 78px 0;
    border-top: 1px solid var(--color-rule);
  }

  .audience-copy ul {
    display: grid;
    gap: 12px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .audience-copy li {
    border-top: 1px solid var(--color-rule);
    padding-top: 12px;
    color: var(--color-ink);
    font-size: 15px;
  }

  .process {
    padding: 78px 0 86px;
    border-top: 1px solid var(--color-rule);
    background: var(--color-cyan-soft);
  }

  .section-head {
    max-width: 720px;
    margin-bottom: 34px;
  }

  .process-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-list li {
    min-height: 250px;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    padding: 24px;
  }

  .process-list span {
    display: block;
    margin-bottom: 44px;
    color: var(--color-ink-3);
    font-size: 12px;
  }

  .process-list p {
    margin: 0;
    color: var(--color-ink-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .cta {
    padding: 74px 0;
    border-top: 1px solid var(--color-rule);
    background: #111b2b;
    color: var(--color-bg);
  }

  .cta h2 {
    color: var(--color-bg);
  }

  .cta .button {
    background: var(--color-bg);
    color: var(--color-navy);
  }

  @media (max-width: 920px) {
    .hero-grid,
    .audience-grid,
      .cta-grid,
    .process-list {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: 64px;
    }

    .process-list li {
      min-height: 0;
    }

    .process-list span {
      margin-bottom: 28px;
    }
  }
</style>
