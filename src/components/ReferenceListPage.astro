---
/**
 * Shared shell for the three reference pages (partners, press, testimonials)
 * in both locales: hero + chronological/ordered entry list + CTA strip.
 * Each entry's prose comes from an MDX content-collection body.
 */
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { Locale } from "~/lib/site";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CTAStrip from "~/components/CTAStrip.astro";

export interface ReferenceEntry {
  id: string;
  kicker: string;          // mono line above the title: role, outlet · date
  title: string;
  url?: string;
  urlLabel?: string;       // "Les hos Firda", "fosen-tools.no"
  note?: string;           // small aside, e.g. "Krever abonnement"
  quote?: boolean;         // render the body as a quoted letter with the title as attribution
  Content: AstroComponentFactory;
}

interface Props {
  locale: Locale;
  altUrl: string;
  title: string;           // <title>
  description: string;     // meta description
  eyebrow: string;
  heading: string;
  lede: string;
  entries: ReferenceEntry[];
  emptyText?: string;
  cta: { title: string; body: string; primary: { href: string; label: string }; secondary?: { href: string; label: string } };
}

const { locale, altUrl, title, description, eyebrow, heading, lede, entries, emptyText, cta } = Astro.props;
---

<BaseLayout locale={locale} altUrl={altUrl} title={title} description={description}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
      </div>
      <p class="lede">{lede}</p>
    </div>
  </section>

  <section class="entries" aria-labelledby="entries-heading">
    <div class="container">
      <h2 id="entries-heading" class="sr-only">{heading}</h2>
      {entries.length === 0 && emptyText && <p class="empty">{emptyText}</p>}
      <ol class="list">
        {entries.map((e) => (
          <li class:list={["entry", { "is-quote": e.quote }]} id={e.id}>
            <article>
              <p class="kicker">{e.kicker}</p>
              <h3>
                {e.url ? <a href={e.url} rel="noopener">{e.title}</a> : e.title}
              </h3>
              {e.quote
                ? <blockquote class="body"><e.Content /></blockquote>
                : <div class="body"><e.Content /></div>}
              {(e.url || e.note) && (
                <p class="meta">
                  {e.url && <a href={e.url} rel="noopener" class="ext">{e.urlLabel ?? e.url} ↗</a>}
                  {e.note && <span class="note">{e.note}</span>}
                </p>
              )}
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CTAStrip title={cta.title} body={cta.body} primary={cta.primary} secondary={cta.secondary} />
</BaseLayout>

<style>
  .container { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
  .eyebrow, .kicker {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--color-navy);
    text-transform: uppercase;
  }
  h1, h3 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  .hero { padding: 88px 0 72px; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.75fr);
    gap: 56px;
    align-items: end;
  }
  .hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(42px, 6vw, 72px);
    line-height: 0.98;
  }
  .lede {
    margin: 0;
    color: var(--color-ink-2);
    font-size: 19px;
    line-height: 1.55;
  }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .entries {
    padding: 24px 0 96px;
    border-top: 1px solid var(--color-rule);
  }
  .empty {
    margin: 48px 0 0;
    color: var(--color-ink-2);
    font-size: 17px;
    line-height: 1.65;
    max-width: 60ch;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry {
    padding: 56px 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .entry:last-child { border-bottom: none; }
  .entry article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 1.1fr);
    gap: 16px 56px;
    align-items: start;
  }
  .kicker { grid-column: 1; margin-bottom: 0; }
  .entry h3 {
    grid-column: 1;
    margin: 0;
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.08;
  }
  .entry h3 a { color: inherit; }
  .entry h3 a:hover { color: var(--color-navy); }
  .body {
    grid-column: 2;
    grid-row: 1 / span 3;
    color: var(--color-ink-2);
    font-size: 17px;
    line-height: 1.65;
  }
  .body :global(p) { margin: 0 0 18px; }
  .body :global(p:last-child) { margin-bottom: 0; }
  blockquote.body {
    margin: 0;
    padding-left: 28px;
    border-left: 2px solid var(--color-cyan);
    color: var(--color-ink);
    font-style: italic;
    font-size: 18px;
    line-height: 1.6;
  }
  .is-quote .kicker { color: var(--color-ink-3); }
  .is-quote h3 { font-size: clamp(22px, 2.4vw, 28px); }
  .meta {
    grid-column: 1;
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 14px;
  }
  .meta .ext {
    color: var(--color-navy);
    font-weight: 500;
  }
  .meta .ext:hover { text-decoration: underline; }
  .meta .note {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    align-self: center;
  }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero { padding-top: 64px; }
    .entry { padding: 44px 0; }
    .entry article { grid-template-columns: 1fr; }
    .body { grid-column: 1; grid-row: auto; margin-top: 8px; }
  }
  @media (max-width: 640px) {
    .container { padding: 0 20px; }
  }
</style>
