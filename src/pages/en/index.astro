---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ProductCard from "~/components/ProductCard.astro";
import FounderCard from "~/components/FounderCard.astro";
import SectionField from "~/components/SectionField.astro";
import CTAStrip from "~/components/CTAStrip.astro";

import heroPhoto from "~/assets/photos/hero-kjersti-garden.jpg";
import productHospitalPhoto from "~/assets/photos/product-hospital-studio.webp";
import productDentistPhoto from "~/assets/photos/product-dentist-contents.jpg";
import fieldAmbulancePhoto from "~/assets/photos/field-ambulance-interior.jpg";
import kjerstiPhoto from "~/assets/photos/founder-kjersti-portrait.jpg";

const products = (await getCollection("products", ({ data }) => data.locale === "en"))
  .sort((a, b) => a.data.productNumber - b.data.productNumber);
---

<BaseLayout
  locale="en"
  altUrl="/"
  title="EmendaKit: Anaphylaxis kits designed and built in Norway"
  description="EmendaKit develops anaphylaxis emergency kits for hospitals, ambulances, maternity wards and dental clinics. Developed by a midwife with broad experience from emergency medicine. Packed to the Norwegian national protocol."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="hero-tag">
          <span class="pulse"></span>
          Designed and built in Norway by healthcare professionals
        </span>
        <h1 class="display">
          An emergency kit designed <span>for when every second counts.</span>
        </h1>
        <p class="lede">
          Anaphylaxis kits developed by midwife Kjersti Grinde, for clinicians
          who have to act fast. Waterproof. Shock-resistant. Structured in line with
          the Norwegian anaphylaxis guidelines.
        </p>
        <a href="/en/contact" class="hero-cta"><span class="dot"></span> Request a quote</a>
      </div>
    </div>
    <figure class="hero-photo">
      <Image
        src={heroPhoto}
        alt="Kjersti Grinde, midwife and founder of EmendaKit, holding the anaphylaxis kit"
        widths={[720, 1080, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="products">
    <div class="container">
      <div class="products-head">
        <div>
          <div class="eyebrow">Two kits · one framework</div>
          <h2>Prepared for acute situations.</h2>
        </div>
        <p>
          The same clinical framework, adapted to two different needs. Both are
          developed in line with the national anaphylaxis guidelines and ship
          with a QR code to training films.
        </p>
      </div>
      <div class="product-grid">
        {products.map((p) => (
          <ProductCard
            title={p.data.title}
            summary={p.data.summary}
            href={`/en/product/${p.data.urlSlug}`}
            productNumber={p.data.productNumber}
            audience={p.data.audience}
            specs={p.data.specs.slice(0, 4)}
            image={p.data.productNumber === 1 ? productHospitalPhoto : productDentistPhoto}
            imageAlt={`${p.data.title}, ${p.data.descriptor}`}
            priceLabel={p.data.priceLabel}
            linkLabel="Product details"
            orderHref={`/en/contact?topic=${encodeURIComponent(p.data.title)}`}
            orderLabel="Order now"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="field">
    <div class="container">
      <SectionField
        image={fieldAmbulancePhoto}
        imageAlt="Inside the air ambulance: patient care with the anaphylaxis kit within reach"
        eyebrow="Field experience · Helse Førde"
        title="Designed by the patient's side, not at a desk."
        body="EmendaKit was not born in a meeting room, but in moments with patients. Every detail, from the adrenaline cover to the QR field linking to training films, comes from concrete situations where something had to work better."
        quote="“Innovation through knowledge and experience.”"
        attribution="The foundation of EmendaKit, from day one."
      />
    </div>
  </section>

  <section class="founders">
    <div class="container">
      <div class="founders-head">
        <div class="eyebrow">Built by clinicians</div>
        <h2>A voice from practice. One system for acute situations.</h2>
      </div>
      <div class="founders-grid">
        <FounderCard
          image={kjerstiPhoto}
          imageAlt="Kjersti Grinde, midwife and founder of EmendaKit"
          role="Founder · Midwife"
          name="Kjersti Grinde"
          bio="Midwife with broad experience from emergency medicine, professional development and medical simulation. Initiated and developed EmendaKit from clinical practice."
        />
      </div>
    </div>
  </section>

  <CTAStrip
    title="Need a kit tailored to your needs?"
    body="We develop and adapt medical emergency kits in collaboration with you, for maternity wards, vaccination sites, ambulance services, dental clinics and other settings with specific needs. The solutions can also be developed for use outside healthcare, in fitness centres, kindergartens, as well as aviation and maritime, where access to the right equipment and structured handling is critical."
    primary={{ href: "/en/contact?topic=Custom%20kit", label: "Request a design conversation →" }}
    secondary={{ href: "mailto:kjersti@emendakit.com", label: "kjersti@emendakit.com" }}
  />
</BaseLayout>

<style>
  .container { max-width: 1320px; margin: 0 auto; padding: 0 32px; }

  /* ─── hero ─── */
  .hero { padding: 80px 0 0; }
  .hero-grid { display: grid; grid-template-columns: 1fr; }
  .hero-tag {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--color-cyan-soft);
    color: var(--color-navy-deep);
    font-size: 13px; font-weight: 500;
    padding: 6px 14px 6px 8px;
    border-radius: var(--radius-pill);
    margin-bottom: 28px;
  }
  .hero-tag .pulse {
    width: 8px; height: 8px;
    background: var(--color-navy);
    border-radius: var(--radius-pill);
  }
  h1.display {
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 500;
    margin: 0 0 24px;
    max-width: 14ch;
  }
  h1.display span { color: var(--color-ink-3); }
  .lede {
    font-size: 19px; line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 540px;
  }
  /* CTA shown only on small screens, where the header CTA is hidden */
  .hero-cta { display: none; }
  @media (max-width: 640px) {
    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-top: 28px;
      background: var(--color-navy);
      color: var(--color-bg);
      border-radius: var(--radius-pill);
      padding: 14px 26px;
      font-size: 15px;
      font-weight: 500;
    }
    .hero-cta .dot {
      width: 6px; height: 6px;
      background: var(--color-cyan);
      border-radius: var(--radius-pill);
    }
  }
  .hero-photo {
    margin: 56px 0 0;
    overflow: hidden;
    background: var(--color-ink);
    position: relative;
  }
  .hero-photo img {
    width: 100%; height: auto; display: block;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    object-position: 50% 22%;
  }
  @media (max-width: 960px) {
    .hero-photo { margin-top: 40px; }
    .hero-photo img { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 640px) {
    .hero-photo img { aspect-ratio: 4 / 5; object-position: 50% 30%; }
  }
  .hero-photo figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 14px 18px;
    background: linear-gradient(180deg, transparent 0%, rgb(8 12 20 / 0.7) 100%);
  }
  .stamp {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.78);
  }

  /* ─── products ─── */
  .products {
    padding: 96px 0;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-cyan-soft) 100%);
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  .products-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
    align-items: end;
  }
  .products-head .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-navy);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }
  .products-head h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 3.6vw, 44px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0;
    max-width: 16ch;
  }
  .products-head p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-ink-2);
    margin: 0;
    max-width: 50ch;
  }
  .product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 800px) {
    .products-head,
    .product-grid { grid-template-columns: 1fr; }
    .products-head { gap: 20px; }
  }

  /* ─── field ─── */
  .field { padding: 96px 0; }

  /* ─── founders ─── */
  .founders {
    padding: 96px 0;
    background: var(--color-cyan-soft);
    border-top: 1px solid var(--color-rule);
  }
  .founders-head { text-align: center; margin-bottom: 48px; }
  .founders-head .eyebrow {
    font-family: var(--font-mono); font-size: 12px; color: var(--color-navy);
    text-transform: uppercase; letter-spacing: 0.12em;
    margin-bottom: 14px;
  }
  .founders-head h2 {
    font-family: var(--font-display); font-size: clamp(32px, 3.6vw, 44px); font-weight: 500;
    letter-spacing: -0.025em; line-height: 1.05;
    margin: 0 auto;
    max-width: 22ch;
  }
  .founders-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 560px;
    margin: 0 auto;
  }
</style>
